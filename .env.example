# Copy to `.env` and chmod 600. Never commit `.env`. Never paste values in chat.
# Format: KEY=value with no quotes. Blank is ok until you paste.

# Required — Hugging Face (gated download + Hub publish; use a write token to upload)
HF_TOKEN=

# Optional — GitHub API rate limits when cloning method repos
# git push still uses `git credential.helper`, not this key
GITHUB_TOKEN=

