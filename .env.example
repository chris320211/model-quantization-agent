# Optional: raises GitHub API rate limit for public clones
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Hugging Face token for gated models (e.g. meta-llama/*)
# HUGGINGFACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional workspace root (defaults to this repository)
# QUANT_AGENT_WORKSPACE=/path/to/model-quantization-agent

# Optional torch pin for method venvs (format: torch==X.Y.Z|cuZZZ)
# QUANT_AGENT_TORCH_SPEC=torch==2.3.1|cu121
